const enlaces = [
  {
    etiqueta: 'X (Twitter)',
    logo: 'x',
    clave: 'links.x.desc',
    url: 'https://x.com/pjzara',
  },
  {
    etiqueta: 'GitHub',
    logo: 'github',
    clave: 'links.github.desc',
    url: 'https://github.com/JuanPardos',
  },
  {
    etiqueta: 'AniList',
    logo: 'anilist',
    clave: 'links.anilist.desc',
    url: 'https://anilist.co/user/MrPardios',
  },
  {
    etiqueta: 'Steam',
    logo: 'steam',
    clave: 'links.steam.desc',
    url: 'https://steamcommunity.com/id/MrPardios',
  },
];
---

<Layout title="Links — Juan Pardos">
  <main>
    <a class="volver" href="/" data-i18n="nav.home"/>
    <h1 data-i18n="links.title"/>
    <p class="intro" data-i18n="links.intro"/>

    <ul class="lista">
      {
        enlaces.map((enlace) => {
          const externo = enlace.url.startsWith('http');
          return (
            <li>
              <a
                href={enlace.url}
                target={externo ? '_blank' : undefined}
                rel={externo ? 'noopener noreferrer' : undefined}
              >
                <svg class="logo" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={logos[enlace.logo]} />
                </svg>
                <div class="texto">
                  <h2>{enlace.etiqueta}</h2>
                  <p data-i18n={enlace.clave}/>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>
  </main>
</Layout>

<style>
  main {
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
    flex: 1;
  }

  .volver {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 2.75rem);
    letter-spacing: -0.02em;
  }

  .intro {
    color: var(--muted);
    margin-top: 0.75rem;
    margin-bottom: 2.5rem;
  }

  .lista {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .lista a {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }

  .lista a:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .logo {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    color: var(--text);
  }

  .lista a:hover .logo {
    color: var(--accent);
  }

  .texto h2 {
    color: var(--text);
    font-size: 1.15rem;
    margin-bottom: 0.4rem;
  }

  .texto p {
    color: var(--muted);
    font-size: 0.95rem;
  }
</style>
