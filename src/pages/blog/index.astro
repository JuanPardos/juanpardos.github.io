---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const articulos = (await getCollection('blog', ({ data }) => !data.borrador)).sort(
  (a, b) => b.data.fecha.getTime() - a.data.fecha.getTime(),
);

const formatoFecha = (fecha: Date) =>
  fecha.toLocaleDateString('es-ES', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
---

<Layout title="Blog — Juan Pardos" description="Artículos, ideas y notas.">
  <main>
    <a class="volver" href="/" data-i18n="nav.home">← Inicio</a>
    <h1 data-i18n="blog.title">Blog</h1>
    <p class="intro" data-i18n="blog.intro">Artículos, tutoriales y notas sobre lo que voy aprendiendo.</p>

    {
      articulos.length === 0 ? (
        <p class="vacio" data-i18n="blog.empty">Todavía no hay artículos publicados.</p>
      ) : (
        <ul class="lista">
          {articulos.map((articulo) => (
            <li>
              <a href={`/blog/${articulo.id}`}>
                <time datetime={articulo.data.fecha.toISOString()} data-i18n-date>
                  {formatoFecha(articulo.data.fecha)}
                </time>
                <h2>{articulo.data.titulo}</h2>
                <p>{articulo.data.descripcion}</p>
                {articulo.data.etiquetas.length > 0 && (
                  <ul class="etiquetas">
                    {articulo.data.etiquetas.map((etiqueta) => (
                      <li>{etiqueta}</li>
                    ))}
                  </ul>
                )}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </main>
</Layout>

<style>
  main {
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
    flex: 1;
  }

  .volver {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 2.75rem);
    letter-spacing: -0.02em;
  }

  .intro {
    color: var(--muted);
    margin-top: 0.75rem;
    margin-bottom: 2.5rem;
  }

  .vacio {
    color: var(--muted);
  }

  .lista {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .lista a {
    display: block;
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }

  .lista a:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    text-decoration: none;
  }

  time {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .lista h2 {
    color: var(--text);
    font-size: 1.25rem;
    margin: 0.4rem 0 0.5rem;
  }

  .lista p {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .etiquetas {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.9rem;
  }

  .etiquetas li {
    color: var(--accent);
    background: rgba(88, 166, 255, 0.12);
    border: 1px solid rgba(88, 166, 255, 0.35);
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
    font-size: 0.8rem;
    font-weight: 600;
  }
</style>
