---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import underConstruction from '../../assets/under_construction.avif';
import sword from '../../assets/sword.svg';
import { langStaticPaths, asLang, useTranslations, localizedPath, formatDate } from '../../i18n/utils';

export const getStaticPaths = langStaticPaths;

const lang = asLang(Astro.params.lang);
const t = useTranslations(lang);

const nombre = 'Juan Pardos';
const buildDate = new Date();

const tarjetas = [
  { clave: 'blog', url: localizedPath('/blog', lang), icono: 'M4 4h16v16H4z M4 9h16 M9 13h7 M9 16h5' },
  { clave: 'skills', url: localizedPath('/skills', lang), icono: 'M12 2l3 7h7l-5.5 4 2 7L12 16l-6.5 4 2-7L2 9h7z' },
  { clave: 'links', url: localizedPath('/links', lang), icono: 'M10 13a5 5 0 007 0l3-3a5 5 0 00-7-7l-1 1 M14 11a5 5 0 00-7 0l-3 3a5 5 0 007 7l1-1' },
  { clave: 'contact', url: localizedPath('/contact', lang), icono: 'M2 5h20v14H2z M2 7l10 6 10-6' },
];
---

<Layout title={nombre} lang={lang}>
  <main>
    <header class="hero">
      <h1>{nombre}</h1>
      <p class="titular">{t('home.tagline')}</p>
      <p class="intro">
          <span>{t('home.intro')}</span>
          <Image src={sword} alt="Sword" width="20" height="20" loading="eager"/>
      </p>
    </header>

    <section class="tarjetas">
      <div class="grid">
        {
          tarjetas.map((tarjeta) => (
            <a class="card" href={tarjeta.url}>
              <svg
                class="card-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={tarjeta.icono} />
              </svg>
              <h2>{t(`card.${tarjeta.clave}.title`)}</h2>
              <p>{t(`card.${tarjeta.clave}.desc`)}</p>
            </a>
          ))
        }
      </div>
    </section>

    <footer>
      <p>©2026 {nombre}. {t('footer.made')}</p>
      <p class="build">
          {t('footer.build')}
          <time datetime={buildDate.toISOString()}>{formatDate(buildDate, lang, true)}</time>
      </p>
    </footer>

    <div class="meme">
        <Image src={underConstruction} alt="Site under construction" loading="eager"/>
    </div>

  </main>
</Layout>

<style>
  main {
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
    flex: 1;
  }

  .hero {
    margin-bottom: 3rem;
  }

  h1 {
    font-size: clamp(2.5rem, 8vw, 3.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .titular {
    font-size: 1.25rem;
    color: var(--accent);
    margin-top: 0.5rem;
  }

  .intro {
    color: var(--muted);
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
  }

  .card {
    display: block;
    padding: 1.75rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }

  .card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .card-icon {
    width: 28px;
    height: 28px;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .card h2 {
    color: var(--text);
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .card p {
    color: var(--muted);
    font-size: 0.95rem;
  }

  footer {
    margin-top: 4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.9rem;
  }

  footer .build {
    margin-top: 0.25rem;
    font-size: 0.8rem;
    opacity: 0.8;
  }

  footer .build time {
    display: inline-flex;
    gap: 0.35ch;
  }

  .meme {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  .meme img {
    max-width: 100%;
    height: auto;
  }
</style>
