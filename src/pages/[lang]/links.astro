  steam:
    'M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0zM7.54 18.21l-1.473-.61c.262.543.714.999 1.314 1.25 1.297.539 2.793-.076 3.332-1.375.263-.63.264-1.319.005-1.949s-.75-1.121-1.377-1.383c-.624-.26-1.29-.249-1.878-.03l1.523.63c.956.4 1.409 1.5 1.009 2.455-.397.957-1.497 1.41-2.454 1.012H7.54zm11.415-9.303c0-1.662-1.353-3.015-3.015-3.015-1.665 0-3.015 1.353-3.015 3.015 0 1.665 1.35 3.015 3.015 3.015 1.663 0 3.015-1.35 3.015-3.015zm-5.273-.005c0-1.252 1.013-2.266 2.265-2.266 1.249 0 2.266 1.014 2.266 2.266 0 1.251-1.017 2.265-2.266 2.265-1.253 0-2.265-1.014-2.265-2.265z',
};

const enlaces = [
  { etiqueta: 'X (Twitter)', logo: 'x', clave: 'links.x.desc', url: 'https://x.com/pjzara' },
  { etiqueta: 'GitHub', logo: 'github', clave: 'links.github.desc', url: 'https://github.com/JuanPardos' },
  { etiqueta: 'AniList', logo: 'anilist', clave: 'links.anilist.desc', url: 'https://anilist.co/user/MrPardios' },
  { etiqueta: 'Steam', logo: 'steam', clave: 'links.steam.desc', url: 'https://steamcommunity.com/id/MrPardios' },
];

type AnimeActual = {
  titulo: string;
  portada: string;
  url: string;
};

type AnilistData = {
  anime: Anime;
  manga: Manga;
}

type Anime = {
  planning: string;
  completed: string;
  episodesWatched: string;
  meanScore: string;
}

type Manga = {
  planning: string;
  chaptersRead: string;
  meanScore: string;
}

let datosAnilist: AnilistData = {
  anime: { planning: '0', completed: '0', episodesWatched: '0', meanScore: '0' },
  manga: { planning: '0', chaptersRead: '0', meanScore: '0' },
};

try {
  const respuesta = await fetch('https://graphql.anilist.co', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      Accept: 'application/json',
    },
    body: JSON.stringify({
      query: `
        query ($name: String) {
          User(name: $name) {
            statistics {
              anime {
                statuses {
                  status
                  count
                },
                episodesWatched,
                meanScore
              }
              manga {
                statuses {
                  status
                  count
                },
                chaptersRead,
                meanScore
              }
            }
          }
        }
      `,
        variables: { name: 'MrPardios' },
      }),
  });

  if (respuesta.ok){
    const datos = await respuesta.json();
    const animeStatuses = datos?.data?.User?.statistics?.anime?.statuses ?? [];
    const mangaStatuses = datos?.data?.User?.statistics?.manga?.statuses ?? [];

    const animePlanning = animeStatuses.find((status: any) => status.status === 'PLANNING')?.count ?? 0;
    const animeCompleted = animeStatuses.find((status: any) => status.status === 'COMPLETED')?.count ?? 0;
    const episodesWatched = datos?.data?.User?.statistics?.anime?.episodesWatched ?? 0;
    const meanScore = datos?.data?.User?.statistics?.anime?.meanScore ?? 0;

    const mangaPlanning = mangaStatuses.find((status: any) => status.status === 'PLANNING')?.count ?? 0;
    const chaptersRead = datos?.data?.User?.statistics?.manga?.chaptersRead ?? 0;
    const mangaMeanScore = datos?.data?.User?.statistics?.manga?.meanScore ?? 0;

    datosAnilist = {
      anime: { planning: String(animePlanning), completed: String(animeCompleted), episodesWatched: String(episodesWatched), meanScore: String(meanScore) },
      manga: { planning: String(mangaPlanning), chaptersRead: String(chaptersRead), meanScore: String(mangaMeanScore) },
    };
  }
}catch(error){
  console.error('Anilist error:', error);
}

let animesActuales: AnimeActual[] = [];

try {
  const respuesta = await fetch('https://graphql.anilist.co', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      Accept: 'application/json',
    },
    body: JSON.stringify({
      query: `
        query ($usuario: String) {
          MediaListCollection(userName: $usuario, type: ANIME, status: CURRENT) {
            lists {
              entries {
                media {
                  id
                  title { romaji english }
                  coverImage { large }
                  siteUrl
                }
              }
            }
          }
        }
      `,
      variables: { usuario: 'MrPardios' },
    }),
  });

  if (respuesta.ok) {
    const datos = await respuesta.json();
    const entradas =
      datos?.data?.MediaListCollection?.lists?.flatMap((lista: any) => lista.entries) ?? [];
    const vistos = new Set<number>();
    animesActuales = entradas
      .filter((entrada: any) => {
        if (vistos.has(entrada.media.id)) return false;
        vistos.add(entrada.media.id);
        return true;
      })
      .map((entrada: any) => ({
        titulo: entrada.media.title.english ?? entrada.media.title.romaji,
        portada: entrada.media.coverImage.large,
        url: entrada.media.siteUrl,
      }));
  }
} catch (error) {
  console.error('Anilist error:', error);
}

type RepoFijado = {
  nombre: string;
  descripcion: string;
  lenguaje: string;
  estrellas: string;
  forks: string;
  url: string;
};

let reposFijados: RepoFijado[] = [];

const GITHUB_USER = 'JuanPardos';
const githubToken = import.meta.env.GITHUB_TOKEN;

async function reposDesdeGitHub(token: string): Promise<RepoFijado[]> {
  const respuesta = await fetch('https://api.github.com/graphql', {
    method: 'POST',
    headers: {
      Authorization: `Bearer ${token}`,
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({
      query: `
        query ($usuario: String!) {
          user(login: $usuario) {
            pinnedItems(first: 6, types: REPOSITORY) {
              nodes {
                ... on Repository {
                  name
                  description
                  url
                  stargazerCount
                  forkCount
                  primaryLanguage { name }
                }
              }
            }
          }
        }
      `,
      variables: { usuario: GITHUB_USER },
    }),
  });

  if (!respuesta.ok) throw new Error(`GitHub GraphQL ${respuesta.status}`);
  const datos = await respuesta.json();
  const nodos = datos?.data?.user?.pinnedItems?.nodes ?? [];
  return nodos.map((repo: any) => ({
    nombre: repo.name,
    descripcion: repo.description ?? '',
    lenguaje: repo.primaryLanguage?.name ?? '',
    estrellas: String(repo.stargazerCount ?? 0),
    forks: String(repo.forkCount ?? 0),
    url: repo.url,
  }));
}

async function reposDesdeBerrysauce(): Promise<RepoFijado[]> {
  const respuesta = await fetch(`https://pinned.berrysauce.dev/get/${GITHUB_USER}`);
  if (!respuesta.ok) throw new Error(`berrysauce ${respuesta.status}`);
  const datos = await respuesta.json();
  return (datos ?? []).map((repo: any) => ({
    nombre: repo.name,
    descripcion: repo.description ?? '',
    lenguaje: repo.language ?? '',
    estrellas: String(repo.stars ?? 0),
    forks: String(repo.forks ?? 0),
    url: `https://github.com/${repo.author}/${repo.name}`,
  }));
}

try {
  reposFijados = githubToken ? await reposDesdeGitHub(githubToken) : await reposDesdeBerrysauce();
} catch (error) {
  console.error('Github error:', error);
  try {
    reposFijados = await reposDesdeBerrysauce();
  } catch (errorRespaldo) {
    console.error('Github respaldo error:', errorRespaldo);
  }
}
---

<Layout title={`${t('links.title')} — Juan Pardos`} lang={lang}>
  <main>
    <a class="volver" href={localizedPath('/', lang)}>{t('nav.home')}</a>
    <h1>{t('links.title')}</h1>
    <p class="intro">{t('links.intro')}</p>

    <ul class="lista">
      {
        enlaces.map((enlace) => {
          const externo = enlace.url.startsWith('http');
          const esAniList = enlace.etiqueta === 'AniList';
          const esSteam = enlace.etiqueta === 'Steam';
          const esGitHub = enlace.etiqueta === 'GitHub';
          const mostrarAnimes = esAniList && animesActuales.length > 0;
          const mostrarRepos = esGitHub && reposFijados.length > 0;

          return (
            <li class={esAniList || esSteam || mostrarRepos ? 'card' : undefined}>
              <a href={enlace.url} target={externo ? '_blank' : undefined} rel={externo ? 'noopener noreferrer' : undefined}>
                <svg class="logo" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={logos[enlace.logo]} />
                </svg>
                <div class="texto">
                  <h2>{enlace.etiqueta}</h2>
                  <p>{t(enlace.clave)}</p>
                </div>
              </a>

              {esAniList && (
                <div class="anilist-stats">
                  <div class="stat">
                    <span class="stat-titulo">{t('links.anilist.anime')}</span>
                    <div class="stat-valores">
                      <span class="chip"><strong>{datosAnilist.anime.completed}</strong> <span>{t('links.anilist.completed')}</span></span>
                      <span class="chip"><strong>{datosAnilist.anime.planning}</strong> <span>{t('links.anilist.planning')}</span></span>
                      <span class="chip"><strong>{datosAnilist.anime.episodesWatched}</strong> <span>{t('links.anilist.episodesWatched')}</span></span>
                      <span class="chip"><strong>{datosAnilist.anime.meanScore}</strong> <span>{t('links.anilist.meanScore')}</span></span>
                    </div>
                  </div>
                  <div class="stat">
                    <span class="stat-titulo">{t('links.anilist.manga')}</span>
                    <div class="stat-valores">
                      <span class="chip"><strong>{datosAnilist.manga.chaptersRead}</strong> <span>{t('links.anilist.chaptersRead')}</span></span>
                      <span class="chip"><strong>{datosAnilist.manga.planning}</strong> <span>{t('links.anilist.planning')}</span></span>
                      <span class="chip"><strong>{datosAnilist.manga.meanScore}</strong> <span>{t('links.anilist.meanScore')}</span></span>
                    </div>
                  </div>
                </div>
              )}

              {mostrarAnimes && (
                <details class="animes">
                  <summary>
                    <span>{t('links.anilist.watchingList')}</span>
                    <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path d="M6 9l6 6 6-6" />
                    </svg>
                  </summary>
                  <ul class="galeria">
                    {animesActuales.map((anime) => (
                      <li>
                        <a href={anime.url} target="_blank" rel="noopener noreferrer" title={anime.titulo}>
                          <Image src={anime.portada} alt={anime.titulo} width={230} height={275} loading="lazy" />
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              )}

              {mostrarRepos && (
                <details class="animes">
                  <summary>
                    <span>{t('links.github.pinned')}</span>
                    <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path d="M6 9l6 6 6-6" />
                    </svg>
                  </summary>
                  <div class="repos">
                    {reposFijados.map((repo) => (
                      <a class="repo" href={repo.url} target="_blank" rel="noopener noreferrer">
                        <h3>{repo.nombre}</h3>
                        {repo.descripcion && <p>{repo.descripcion}</p>}
                        <div class="repo-meta">
                          {repo.lenguaje && <span>{repo.lenguaje}</span>}
                          <span>★ {repo.estrellas}</span>
                          <span>⑂ {repo.forks}</span>
                        </div>
                      </a>
                    ))}
                  </div>
                </details>
              )}

              {esSteam && (
                <div class="steam-perfil">
                  <iframe
                    src="https://gamer2810.github.io/steam-miniprofile/?accountId=130699687&interactive=true&vanityId=MrPardios"
                    title="Steam miniprofile"
                    loading="eager"
                  />
                </div>
              )}
            </li>
          );
        })
      }
    </ul>
  </main>
</Layout>

<style>
  main {
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
    flex: 1;
  }

  .volver {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 2.75rem);
    letter-spacing: -0.02em;
  }

  .intro {
    color: var(--muted);
    margin-top: 0.75rem;
    margin-bottom: 2.5rem;
  }

  .lista {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .lista a {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }

  .lista a:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .logo {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    color: var(--text);
  }

  .lista a:hover .logo {
    color: var(--accent);
  }

  .texto h2 {
    color: var(--text);
    font-size: 1.15rem;
    margin-bottom: 0.4rem;
  }

  .texto p {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .lista li.card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }

  .lista li.card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .lista li.card > a {
    background: none;
    border: none;
    border-radius: 0;
    transform: none;
  }

  .lista li.card > a:hover {
    transform: none;
  }

  .anilist-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.75rem;
    padding: 0 1.5rem 0.5rem;
  }

  .anilist-stats .stat {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1rem;
    background: var(--bg, rgba(0, 0, 0, 0.15));
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .anilist-stats .stat-titulo {
    color: var(--text);
    font-size: 0.95rem;
    font-weight: 600;
  }

  .anilist-stats .stat-valores {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .anilist-stats .chip {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.8rem;
  }

  .anilist-stats .chip strong {
    color: var(--accent);
    font-size: 0.95rem;
  }

  .animes {
    padding: 0 1.5rem 1.5rem;
  }

  .animes summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    cursor: pointer;
    color: var(--text);
    font-size: 1rem;
    font-weight: 600;
    padding: 0.75rem 0;
    list-style: none;
  }

  .animes summary::-webkit-details-marker {
    display: none;
  }

  .animes .chevron {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: var(--muted);
    transition: transform 0.2s;
  }

  .animes[open] .chevron {
    transform: rotate(180deg);
  }

  .galeria {
    margin-top: 1rem;
  }

  .galeria {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 1rem;
  }

  .galeria a {
    display: block;
    padding: 0;
    background: none;
    border: none;
    border-radius: 0;
  }

  .galeria img {
    display: block;
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid var(--border);
    transition:
      border-color 0.2s,
      transform 0.2s;
  }

  .galeria a:hover img {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .repos {
    margin-top: 1rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.75rem;
  }

  .repos .repo {
    display: block;
    padding: 1rem;
    background: var(--bg, rgba(0, 0, 0, 0.15));
    border: 1px solid var(--border);
    border-radius: 8px;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }

  .repos .repo:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .repos .repo h3 {
    color: var(--text);
    font-size: 0.95rem;
    margin-bottom: 0.4rem;
  }

  .repos .repo p {
    color: var(--muted);
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
  }

  .repos .repo-meta {
    display: flex;
    gap: 1rem;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .steam-perfil {
    padding: 0 1.5rem 1.5rem;
    display: flex;
    justify-content: center;
  }

  .steam-perfil iframe {
    display: block;
    width: 370px;
    max-width: 100%;
    height: 240px;
    border: none;
    border-radius: 8px;
  }
</style>
