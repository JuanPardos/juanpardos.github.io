---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Página personal de Juan Pardos' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />

    <div class="lang-switcher" role="group" aria-label="Idioma / Language">
      <button type="button" class="flag-btn" data-lang-btn="es" aria-pressed="true" title="Español">
        <svg class="flag" viewBox="0 0 3 2" preserveAspectRatio="none" aria-hidden="true">
          <rect width="3" height="2" fill="#c60b1e" />
          <rect width="3" height="1" y="0.5" fill="#ffc400" />
        </svg>
        <span>ES</span>
      </button>
      <button type="button" class="flag-btn" data-lang-btn="en" aria-pressed="false" title="English">
        <svg class="flag" viewBox="0 0 60 30" preserveAspectRatio="none" aria-hidden="true">
          <clipPath id="uk-s"><path d="M0,0 v30 h60 v-30 z" /></clipPath>
          <clipPath id="uk-t"><path d="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z" /></clipPath>
          <g clip-path="url(#uk-s)">
            <path d="M0,0 v30 h60 v-30 z" fill="#012169" />
            <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6" />
            <path d="M0,0 L60,30 M60,0 L0,30" clip-path="url(#uk-t)" stroke="#C8102E" stroke-width="4" />
            <path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10" />
            <path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6" />
          </g>
        </svg>
        <span>EN</span>
      </button>
    </div>

    <script>
      import { applyLang, currentLang, STORAGE_KEY } from '../i18n/runtime';

      applyLang(currentLang());

      document.querySelectorAll<HTMLElement>('[data-lang-btn]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const lang = btn.dataset.langBtn;
          if (lang === 'es' || lang === 'en') {
            localStorage.setItem(STORAGE_KEY, lang);
            applyLang(lang);
          }
        });
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0d1117;
    --surface: #161b22;
    --text: #e6edf3;
    --muted: #8b949e;
    --accent: #58a6ff;
    --border: #30363d;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-family:
      system-ui,
      -apple-system,
      'Segoe UI',
      Roboto,
      sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  a {
    color: var(--accent);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  .lang-switcher {
    position: fixed;
    bottom: 1.25rem;
    right: 1.25rem;
    display: flex;
    gap: 0.5rem;
    padding: 0.4rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    z-index: 10;
  }

  .flag-btn {
    position: relative;
    width: 58px;
    height: 40px;
    border: 2px solid transparent;
    border-radius: 8px;
    overflow: hidden;
    padding: 0;
    cursor: pointer;
    opacity: 0.55;
    transition:
      opacity 0.2s,
      transform 0.2s,
      border-color 0.2s;
  }

  .flag-btn .flag {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .flag-btn span {
    position: absolute;
    bottom: 3px;
    right: 4px;
    font-size: 0.7rem;
    font-weight: 700;
    color: #fff;
    background: rgba(0, 0, 0, 0.55);
    padding: 0.05rem 0.3rem;
    border-radius: 4px;
    line-height: 1.3;
  }

  .flag-btn:hover {
    opacity: 0.85;
  }

  .flag-btn[aria-pressed='true'] {
    opacity: 1;
    border-color: var(--accent);
    transform: scale(1.05);
  }
</style>
